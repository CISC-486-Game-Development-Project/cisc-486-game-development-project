; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CISC 486 Game Development Project"
run/main_scene="uid://vv680s1adm4y"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://Assets/2D/Sprites/icon.svg"

[autoload]

Globals="*uid://cdjwd5raysu57"
SceneManager="*uid://frgi6tweejw5"
AudioManager="*uid://bcq5ihk6khspi"
GrassManager="*uid://dj8l4pv3cghxy"
ItemManager="*uid://xdr6ico71s6m"
RaceManager="*uid://bf54wioynsdmg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/hdr/request_hdr_output=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/csv-data-importer/plugin.cfg", "res://addons/inspector_code_highlighter/plugin.cfg", "res://addons/mesh_painter/plugin.cfg")

[global_group]

Paved="Terrain type ideal for driving"
Offroad="Terrain type that doesn't allow full speed"
"Harsh Offroad"="Terrain type that strongly affects kart performance"

